FROM node:22-alpine

# 安装 pnpm
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# 设置工作目录
WORKDIR /app

# 复制依赖配置文件
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY .npmrc ./
COPY patches/ ./patches/

# 创建 .npmrc 配置，强制提升依赖
RUN echo "registry=https://registry.npmmirror.com" > .npmrc && \
    echo "shamefully-hoist=true" >> .npmrc && \
    echo "strict-peer-dependencies=false" >> .npmrc

# 临时移除 patch 配置以避免构建错误
RUN sed -i '/patchedDependencies:/,/juice@11.1.1/d' pnpm-workspace.yaml

# 复制所有 package.json 文件（保持 workspace 结构）
COPY apps/web/package.json ./apps/web/
COPY packages/core/package.json ./packages/core/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/mcp-server/package.json ./packages/mcp-server/
COPY packages/md-cli/package.json ./packages/md-cli/

# 安装依赖（跳过 postinstall 脚本）
RUN pnpm install --ignore-scripts

# 复制源代码
COPY . .

# 暴露端口
EXPOSE 5173

# 设置环境变量
ENV HOST=0.0.0.0
ENV PORT=5173

# 启动开发服务器
CMD ["pnpm", "web", "dev", "--host"]
